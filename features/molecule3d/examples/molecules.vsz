# MolecularRenaissance, fast mode only. Enable molecule3d and restart first.
# Independent molecule widgets and ordinary caption labels; no browser.
Add('page', name='molecules3d', autoadd=False)
To('molecules3d')
Set('width', '24cm')
Set('height', '18cm')
Add('molecule3d', name='water', autoadd=False)
Set('water/model', 'water')
Set('water/scale', 30.0)
Set('water/labels', True)
Set('water/labelSize', 12.0)
Set('water/xPos', [0.18])
Set('water/yPos', [0.76])
Add('label', name='water_title', autoadd=False)
Set('water_title/label', 'Water: hatch and labels')
Set('water_title/xPos', [0.18])
Set('water_title/yPos', [0.57])
Set('water_title/alignHorz', 'centre')
Add('molecule3d', name='ethanol', autoadd=False)
Set('ethanol/model', 'ethanol')
Set('ethanol/scale', 24.0)
Set('ethanol/shading', 'stipple')
Set('ethanol/yaw', 35.0)
Set('ethanol/xPos', [0.50])
Set('ethanol/yPos', [0.76])
Add('label', name='ethanol_title', autoadd=False)
Set('ethanol_title/label', 'Ethanol: stipple')
Set('ethanol_title/xPos', [0.50])
Set('ethanol_title/yPos', [0.57])
Set('ethanol_title/alignHorz', 'centre')
Add('molecule3d', name='c60', autoadd=False)
Set('c60/model', 'c60')
Set('c60/scale', 18.0)
Set('c60/colored', False)
Set('c60/xPos', [0.82])
Set('c60/yPos', [0.76])
Add('label', name='c60_title', autoadd=False)
Set('c60_title/label', 'C60: monochrome hatch')
Set('c60_title/xPos', [0.82])
Set('c60_title/yPos', [0.57])
Set('c60_title/alignHorz', 'centre')
Add('molecule3d', name='halftone', autoadd=False)
Set('halftone/model', 'c60')
Set('halftone/shading', 'halftone')
Set('halftone/scale', 18.0)
Set('halftone/pitch', 25.0)
Set('halftone/xPos', [0.18])
Set('halftone/yPos', [0.31])
Add('label', name='halftone_title', autoadd=False)
Set('halftone_title/label', 'C60: halftone')
Set('halftone_title/xPos', [0.18])
Set('halftone_title/yPos', [0.10])
Set('halftone_title/alignHorz', 'centre')
Add('molecule3d', name='textures', autoadd=False)
Set('textures/model', 'ethanol')
Set('textures/scale', 24.0)
Set('textures/colored', False)
Set('textures/elementTextures', True)
Set('textures/yaw', -25.0)
Set('textures/xPos', [0.50])
Set('textures/yPos', [0.31])
Add('label', name='textures_title', autoadd=False)
Set('textures_title/label', 'Ethanol: element textures')
Set('textures_title/xPos', [0.50])
Set('textures_title/yPos', [0.10])
Set('textures_title/alignHorz', 'centre')
Add('molecule3d', name='xyz', autoadd=False)
Set('xyz/model', 'xyz')
Set('xyz/xyz', '3\nCarbon dioxide, idealized\nO -1.16 0 0\nC 0 0 0\nO 1.16 0 0\n')
Set('xyz/scale', 30.0)
Set('xyz/shading', 'none')
Set('xyz/labels', True)
Set('xyz/labelSize', 12.0)
Set('xyz/xPos', [0.82])
Set('xyz/yPos', [0.31])
Add('label', name='xyz_title', autoadd=False)
Set('xyz_title/label', 'Inline XYZ: flat color')
Set('xyz_title/xPos', [0.82])
Set('xyz_title/yPos', [0.10])
Set('xyz_title/alignHorz', 'centre')
To('/')
