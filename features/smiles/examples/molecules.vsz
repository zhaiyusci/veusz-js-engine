# SMILES molecular structures: load veusz_js_engine.py as a plugin first.
# Enable the smiles feature in Tools -> JS Engine Features and restart if needed.
Add('page', name='molecules', autoadd=False)
To('molecules')
Set('width', '24cm')
Set('height', '18cm')

Add('label', name='ethanol', autoadd=False)
Set('ethanol/label', 'CCO')
Set('ethanol/xPos', [0.18])
Set('ethanol/yPos', [0.75])
Set('ethanol/alignHorz', 'centre')
Set('ethanol/alignVert', 'centre')
Set('ethanol/Text/font', 'Arial')
Set('ethanol/Text/size', '14pt')
Set('ethanol/Text/smiles', True)
Add('label', name='ethanol_title', autoadd=False)
Set('ethanol_title/label', 'Ethanol')
Set('ethanol_title/xPos', [0.18])
Set('ethanol_title/yPos', [0.58])
Set('ethanol_title/alignHorz', 'centre')

Add('label', name='benzene', autoadd=False)
Set('benzene/label', 'c1ccccc1')
Set('benzene/xPos', [0.50])
Set('benzene/yPos', [0.75])
Set('benzene/alignHorz', 'centre')
Set('benzene/alignVert', 'centre')
Set('benzene/Text/font', 'Arial')
Set('benzene/Text/size', '14pt')
Set('benzene/Text/smiles', True)
Add('label', name='benzene_title', autoadd=False)
Set('benzene_title/label', 'Benzene')
Set('benzene_title/xPos', [0.50])
Set('benzene_title/yPos', [0.58])
Set('benzene_title/alignHorz', 'centre')

Add('label', name='alanine', autoadd=False)
Set('alanine/label', 'N[C@@H](C)C(=O)O')
Set('alanine/xPos', [0.82])
Set('alanine/yPos', [0.75])
Set('alanine/alignHorz', 'centre')
Set('alanine/alignVert', 'centre')
Set('alanine/Text/font', 'Arial')
Set('alanine/Text/size', '14pt')
Set('alanine/Text/smiles', True)
Add('label', name='alanine_title', autoadd=False)
Set('alanine_title/label', 'Alanine (stereochemistry)')
Set('alanine_title/xPos', [0.82])
Set('alanine_title/yPos', [0.58])
Set('alanine_title/alignHorz', 'centre')

Add('label', name='aspirin', autoadd=False)
Set('aspirin/label', 'CC(=O)Oc1ccccc1C(=O)O')
Set('aspirin/xPos', [0.18])
Set('aspirin/yPos', [0.32])
Set('aspirin/alignHorz', 'centre')
Set('aspirin/alignVert', 'centre')
Set('aspirin/Text/font', 'Arial')
Set('aspirin/Text/size', '12pt')
Set('aspirin/Text/smiles', True)
Add('label', name='aspirin_title', autoadd=False)
Set('aspirin_title/label', 'Aspirin')
Set('aspirin_title/xPos', [0.18])
Set('aspirin_title/yPos', [0.12])
Set('aspirin_title/alignHorz', 'centre')

Add('label', name='caffeine', autoadd=False)
Set('caffeine/label', 'Cn1c(=O)c2c(ncn2C)n(C)c1=O')
Set('caffeine/xPos', [0.50])
Set('caffeine/yPos', [0.32])
Set('caffeine/alignHorz', 'centre')
Set('caffeine/alignVert', 'centre')
Set('caffeine/Text/font', 'Arial')
Set('caffeine/Text/size', '12pt')
Set('caffeine/Text/smiles', True)
Add('label', name='caffeine_title', autoadd=False)
Set('caffeine_title/label', 'Caffeine')
Set('caffeine_title/xPos', [0.50])
Set('caffeine_title/yPos', [0.12])
Set('caffeine_title/alignHorz', 'centre')

Add('label', name='isotope', autoadd=False)
Set('isotope/label', '[13CH3][NH3+]')
Set('isotope/xPos', [0.82])
Set('isotope/yPos', [0.32])
Set('isotope/alignHorz', 'centre')
Set('isotope/alignVert', 'centre')
Set('isotope/Text/font', 'Arial')
Set('isotope/Text/size', '14pt')
Set('isotope/Text/smiles', True)
Add('label', name='isotope_title', autoadd=False)
Set('isotope_title/label', 'Isotope and charge')
Set('isotope_title/xPos', [0.82])
Set('isotope_title/yPos', [0.12])
Set('isotope_title/alignHorz', 'centre')
To('/')
